+#else
+void WebEnginePage::handleFeaturePermissionRequested(
+    const QUrl &securityOrigin, QWebEnginePage::Feature feature) {
+  bool autoPlay = true;
+  if (SettingsManager::instance().settings().value("autoPlayMedia").isValid())
+    autoPlay = SettingsManager::instance()
+                   .settings()
+                   .value("autoPlayMedia", false)
+                   .toBool();
+
+  if (autoPlay &&
+      (feature == QWebEnginePage::MediaVideoCapture ||
+       feature == QWebEnginePage::MediaAudioVideoCapture)) {
+    WebEngineProfileManager::instance().profile()->settings()->setAttribute(
+        QWebEngineSettings::PlaybackRequiresUserGesture, false);
+  }
+
+  const QString title = tr("Permission Request");
+  const QString question = questionForPermission(feature).arg(securityOrigin.host());
+  const QString permissionTypeStr = QString::number(permissionSettingsKey(feature));
+  SettingsManager::instance().settings().beginGroup("permissions");
+
+  QWebEnginePage::PermissionPolicy policy = QWebEnginePage::PermissionDeniedByUser;
+  if (SettingsManager::instance().settings().value(permissionTypeStr, false).toBool()) {
+    policy = QWebEnginePage::PermissionGrantedByUser;
+  } else if (!question.isEmpty() &&
+             QMessageBox::question(view()->window(), title, question) ==
+                 QMessageBox::Yes) {
+    policy = QWebEnginePage::PermissionGrantedByUser;
+    SettingsManager::instance().settings().setValue(permissionTypeStr, true);
+  } else {
+    SettingsManager::instance().settings().setValue(permissionTypeStr, false);
+  }
+
+  setFeaturePermission(securityOrigin, feature, policy);
+  SettingsManager::instance().settings().endGroup();
+}
+#endif

