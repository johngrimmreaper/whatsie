#!/usr/bin/make -f
# Build Whatsie with debhelper's CMake buildsystem.
# Ubuntu packaging targets Qt 6.10 or newer; upstream Linux packaging defaults to Qt 6.11.

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DWHATSIE_BUILD_TESTS=OFF \
		-DWHATSIE_QT_MIN_VERSION=6.10
